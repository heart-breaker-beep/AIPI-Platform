# ============================================================
# 行尾规范化
# ------------------------------------------------------------
# 本仓库 core.autocrlf=true，检出时会把文本文件转成 CRLF。
# 对 shell 脚本是致命的：容器里 shebang 变成 "#!/bin/sh\r"，
# 内核找不到解释器，容器直接启动失败。
#
# 因此明确指定这几类必须保持 LF。
# ============================================================

# --- Shell 脚本：必须 LF ---
*.sh        text eol=lf
*.bash      text eol=lf

# --- Dockerfile / compose：LF 更稳，避免奇怪解析问题 ---
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
docker-compose*.yml text eol=lf

# --- 文本源码：入库统一 LF，检出按平台 ---
*.py        text
*.pyi       text
*.md        text
*.txt       text
*.ini       text
*.cfg       text
*.toml      text
*.json      text
*.yml       text
*.yaml      text
*.sql       text
*.mako      text

# --- 二进制：不要做任何转换 ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
