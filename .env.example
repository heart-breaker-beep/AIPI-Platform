APP_NAME=AI Agent GitHub Project Intelligence Platform
APP_ENV=development
DEBUG=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agent_intelligence
MYSQL_USER=root
MYSQL_PASSWORD=

QDRANT_HOST=localhost
QDRANT_PORT=6333

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# DeepSeek 的 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# Ollama 地址与 embedding 模型（RAG 索引要用）
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3

GITHUB_TOKEN=


# ------------------------------------------------------------
# RAG（语义检索）
# ------------------------------------------------------------
# 默认关闭。
#
# 打开后，证据环节会先把仓库源码索引进 Qdrant，
# 再按六个维度分别做语义检索，把命中的代码片段
# **叠加**进证据清单（而非替换结构分析产出的证据）。
#
# 为什么默认关：
#   1. 索引要额外读 GitHub 文件、调 Ollama 嵌入，
#      实测一个 88 个 .py 的仓库约多花 105 秒；
#   2. 它的增益是否为正取决于仓库规模与提问方式，
#      需要实测对照才能判断，不该让所有分析默认承担。
#
# 前置条件：Ollama 在线且已 pull 对应模型，
#           Qdrant 在线。
#
#   ollama pull bge-m3
RAG_ENABLED=false

# 单次索引最多收录多少个 .py 文件。
# 已读文件（约 20 个，正文已在内存）不额外花钱，
# 其余按剩余名额去 GitHub 补读，每个约 0.9 秒 ——
# 这个值直接决定额外耗时。
RAG_INDEX_MAX_FILES=80

# 每个维度取前几条检索结果（六个维度各查一次）
RAG_LIMIT_PER_DIMENSION=3

# 检索证据并入证据清单后的总上限。
# 与 ReportSynthesisSkill.MAX_EVIDENCE 保持一致，
# 超出部分反正进不了综合分析。
RAG_MAX_EVIDENCE=12