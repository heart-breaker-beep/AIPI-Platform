# ============================================================
# Docker 部署配置模板
# ------------------------------------------------------------
# 用法：cp .env.docker.example .env
#      然后把下面几个空值填上。
#
# 说明：docker compose 会自动读取同目录的 .env 做变量替换。
# 容器里不落 .env 文件，全部以环境变量注入 ——
# 密钥不会被烤进镜像层。
# ============================================================


# ------------------------------------------------------------
# 应用
# ------------------------------------------------------------
APP_ENV=production
DEBUG=false


# ------------------------------------------------------------
# MySQL（复用宿主机实例，不开容器）
# ------------------------------------------------------------
# MYSQL_HOST 由 compose 固定为 host.docker.internal，这里改了不生效，
# 保留只是为了让本文件单独看时也好懂。
MYSQL_HOST=host.docker.internal

# 【注意】宿主机 MySQL 的端口。容器要连的是宿主机的 3306。
MYSQL_PORT=3306

MYSQL_DATABASE=aipi

MYSQL_USER=root

# 【必填】宿主机 MySQL 上这个账号的密码。
# 不填的话 compose 会直接报错退出。
MYSQL_PASSWORD=


# 【前置条件】宿主机 MySQL 必须允许容器连入，否则启动时会
# 「等待 MySQL 超时」。自检两条：
#
#   SHOW VARIABLES LIKE 'bind_address';
#     → 必须是 * 或 0.0.0.0，不能是 127.0.0.1
#
#   SELECT user, host FROM mysql.user WHERE user='root';
#     → 需要有一条 host 为 % 的记录
#        （或为容器网段单独授权的账号）


# ------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333


# ------------------------------------------------------------
# LLM（DeepSeek）
# ------------------------------------------------------------
LLM_PROVIDER=deepseek

# 【必填】https://platform.deepseek.com 申请
LLM_API_KEY=

LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=120

# 综合分析要输出六个维度判断 + 摘要，
# 调小会被截断，截断的 JSON 解析必然失败。
LLM_MAX_TOKENS=8192


# ------------------------------------------------------------
# Embedding
# ------------------------------------------------------------
# 容器内不跑 Ollama。当前代码里 embedding 只被
# ProjectIndexer / RepositoryIndexer 使用，而这两个类
# 全项目没有调用点，留空不影响分析主流程。
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3

# 若宿主机确实跑了 Ollama，用 host.docker.internal 指过去。
OLLAMA_BASE_URL=http://host.docker.internal:11434


# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------
# 【建议填】不填会受匿名 API 限流（每小时 60 次）影响，
# 分析稍大的仓库就会失败。
GITHUB_TOKEN=
